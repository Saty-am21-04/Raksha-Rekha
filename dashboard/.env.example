# RAKSHA-REKHA dashboard — copy to .env.local and fill in.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key. Read-only under the rr_* RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox public access token (pk.*)
NEXT_PUBLIC_MAPBOX_TOKEN=
# Shared secret guarding the compute-scores Edge Function. Must match the value
# set with `supabase secrets set RR_COMPUTE_SECRET=...`.
#
# SERVER-ONLY — deliberately NOT prefixed NEXT_PUBLIC_. A browser cannot hold a
# shared secret, so app/api/recompute/route.ts reads this and proxies the call.
# Leave blank if the project has no secret configured; the proxy then omits the
# header and the function runs unprotected.
RR_COMPUTE_SECRET=
